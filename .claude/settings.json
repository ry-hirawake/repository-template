{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "language": "japanese",
    "effortLevel": "high",
    "fastMode": false,
    "alwaysThinkingEnabled": true,
    "permissions": {
        "allow": [
            "Bash(git add:*)"
        ],
        "ask": [
            "Bash(gh pr create:*)",
            "Bash(git commit:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./**/*.pem)",
            "Read(./**/*.key)",
            "Read(./**/credentials*)",
            "Read(./**/*secret*)",
            "Read(~/.ssh/**)",
            "Read(~/.aws/**)",
            "Read(~/.config/gcloud/**)",
            "Bash(rm -rf /)",
            "Bash(rm -rf ~)"
        ]
    }
}